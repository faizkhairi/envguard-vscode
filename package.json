{
  "name": "envguard-vscode",
  "displayName": "EnvGuard - Env Var Auditor",
  "description": "Inline diagnostics for environment variables -- find missing, unused, and undocumented env vars without leaving your editor",
  "version": "1.0.0",
  "publisher": "faizkhairi",
  "author": "Faiz Khairi <ifaizkhairi@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/faizkhairi/envguard-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "env",
    "dotenv",
    "environment variables",
    "lint",
    "audit",
    ".env",
    ".env.example"
  ],
  "activationEvents": [
    "workspaceContains:**/.env",
    "workspaceContains:**/.env.example"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "EnvGuard",
      "properties": {
        "envguard.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable EnvGuard diagnostics"
        },
        "envguard.includeBuiltins": {
          "type": "boolean",
          "default": false,
          "description": "Include built-in variables (NODE_ENV, PATH, etc.) in diagnostics"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "package": "npx @vscode/vsce package --no-dependencies",
    "publish": "npx @vscode/vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.7.0"
  }
}
